pipeline {
    agent any

    tools {
        maven 'M3'
    }

    environment {
        NEXUS_URL      = 'http://lab7-nexus:8081'
        NEXUS_REPO     = 'maven-snapshots'
        SONAR_HOST_URL = 'http://lab7-sonarqube:9000'
        
        DOCKER_USER     = 'phamthuongdocker'
        DOCKER_IMAGE    = "${DOCKER_USER}/devops-lab8-app-microservice"
        DOCKER_TAG      = "${env.BUILD_NUMBER}"
        CONTAINER_NAME  = 'lab8-cd-production'
        APP_PORT        = '18001'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'STEP 1/13: CHECKOUT — Lấy code từ GitHub...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'STEP 2/13: BUILD — Biên dịch với Maven...'
                dir('user-service') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                echo 'STEP 3/13: TEST — Chạy Unit Tests với JUnit 5...'
                dir('user-service') {
                    sh 'mvn test'
                }
            }
            post {
                success {
                    dir('user-service') {
                        junit 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo 'STEP 4/13: SCAN — Phân tích mã nguồn tĩnh với SonarQube...'
                dir('user-service') {
                    withSonarQubeEnv('SonarQube') {
                        withCredentials([
                            string(
                                credentialsId: 'sonarqube-token',
                                variable: 'SONAR_TOKEN'
                            )
                        ]) {
                            sh '''
                                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                    -Dsonar.projectKey=devops-lab7 \
                                    -Dsonar.projectName="DevOps Lab 7 CI Demo" \
                                    -Dsonar.token="$SONAR_TOKEN"
                            '''
                        }
                    }
                }
            }
        }

        stage('Package') {
            steps {
                echo 'STEP 5/13: PACKAGE — Đóng gói .jar...'
                dir('user-service') {
                    sh 'mvn package -DskipTests'
                    sh '''
                        echo "=== ARTIFACT CREATED ==="
                        ls -lh target/*.jar
                    '''
                    archiveArtifacts(
                        artifacts: 'target/*.jar',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                echo 'STEP 6/13: PUBLISH — Đẩy artifact lên Nexus...'
                dir('user-service') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USERNAME',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        configFileProvider([
                            configFile(
                                fileId: 'maven-settings-nexus',
                                variable: 'MAVEN_SETTINGS'
                            )
                        ]) {
                            sh '''
                                echo "=== CHECK ARTIFACT ==="
                                ls -lh target/
                                echo "=== PUBLISH TO NEXUS ==="
                                mvn deploy:deploy-file \
                                    -s "$MAVEN_SETTINGS" \
                                    -DgroupId=vhbtpm.k22a \
                                    -DartifactId=user-service \
                                    -Dversion=0.0.1-SNAPSHOT \
                                    -Dpackaging=jar \
                                    -Dfile=target/user-service-0.0.1-SNAPSHOT.jar \
                                    -Durl=http://lab7-nexus:8081/repository/maven-snapshots/ \
                                    -DrepositoryId=nexus
                            '''
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'CD STEP 7/13: BUILD IMAGE'
                dir('user-service') {
                    sh '''
                        docker build \
                            -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                            -t ${DOCKER_IMAGE}:latest \
                            .
                    '''
                }
            }
        }

        stage('Docker Scan') {
            steps {
                echo 'CD STEP 8/13: SCAN IMAGE'
                dir('user-service') {
                    sh '''
                        docker scout quickview ${DOCKER_IMAGE}:${DOCKER_TAG} || echo "Scout not available — skip"
                    '''
                }
            }
        }

        stage('Push to Registry') {
            steps {
                echo 'CD STEP 9/13: PUSH TO DOCKER HUB'
                dir('user-service') {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials_1', usernameVariable: 'HUB_USER', passwordVariable: 'HUB_PASS')]) {
                        sh '''
                            echo "$HUB_PASS" | docker login -u "$HUB_USER" --password-stdin
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker push ${DOCKER_IMAGE}:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy Container') {
            steps {
                echo 'CD STEP 10/13: DEPLOY CONTAINER'
                dir('user-service') {
                    sh '''
                        # Stop & remove container cũ nếu có
                        docker stop ${CONTAINER_NAME} 2>/dev/null || true
                        docker rm ${CONTAINER_NAME} 2>/dev/null || true

                        # Lấy tên network mà container Jenkins đang sử dụng
                        JENKINS_NET=$(docker inspect lab7-jenkins --format='{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' | awk '{print $1}')

                        # Deploy container mới vào cùng network với Jenkins
                        docker run -d \
                            --name ${CONTAINER_NAME} \
                            --network ${JENKINS_NET} \
                            -p ${APP_PORT}:18001 \
                            --restart unless-stopped \
                            ${DOCKER_IMAGE}:${DOCKER_TAG}
                    '''
                }
            }
        }

        stage('Verify Deploy') {
            steps {
                echo 'CD STEP 11/13: VERIFY'
                dir('user-service') {
                    sh '''
                        echo "=== TEST LOGIN ==="
                        curl --retry 15 --retry-delay 2 --retry-all-errors -f \
                          -X POST http://${CONTAINER_NAME}:18001/api/users/login \
                          -H "Content-Type: application/json" \
                          -d '{"username":"admin","password":"123456"}'
                        
                        echo ""
                        echo "=== TEST PROFILE ==="
                        curl --retry 15 --retry-delay 2 --retry-all-errors -f \
                          http://${CONTAINER_NAME}:18001/api/users/profile
                        echo ""
                    '''
                }
            }
        }
        stage('API Test with Newman') {
            steps {
                echo 'CD STEP 12/13: API TEST — Chạy kiểm thử tự động với Newman...'
                dir('user-service') {
                    sh '''
                        JENKINS_NET=$(docker inspect lab7-jenkins --format='{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' | awk '{print $1}')
                        mkdir -p newman-reports

                        # Chạy Newman bằng Docker container (tự động truyền biến baseUrl trỏ tới container app)
                        docker run --rm \
                            --network ${JENKINS_NET} \
                            --volumes-from lab7-jenkins \
                            -w "$(pwd)" \
                            postman/newman:alpine \
                            run lab8_microservice.postman_collection.json \
                            --env-var "baseUrl=http://${CONTAINER_NAME}:18001" \
                            --reporters cli,junit \
                            --reporter-junit-export newman-reports/newman-report.xml
                    '''
                }
            }
            post {
                always {
                    dir('user-service') {
                        junit allowEmptyResults: true, testResults: 'newman-reports/*.xml'
                    }
                }
            }
        }

        stage('Security Scan with OWASP ZAP') {
            steps {
                echo 'CD STEP 13/13: DAST SCAN — Quét lỗ hổng bảo mật với OWASP ZAP...'
                dir('user-service') {
                    sh '''
                        JENKINS_NET=$(docker inspect lab7-jenkins --format='{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' | awk '{print $1}')
                        mkdir -p zap-reports
                        chmod 777 zap-reports

                        # Chạy ZAP Baseline Scan (-I để không làm fail pipeline nếu chỉ có cảnh báo mức Warning)
                        docker run --rm \
                            --network ${JENKINS_NET} \
                            --volumes-from lab7-jenkins \
                            -w "$(pwd)/zap-reports" \
                            ghcr.io/zaproxy/zaproxy:stable \
                            zap-baseline.py \
                            -t http://${CONTAINER_NAME}:18001/api/users/profile \
                            -r zap-report.html \
                            -I
                    '''
                }
            }
            post {
                always {
                    dir('user-service') {
                        archiveArtifacts artifacts: 'zap-reports/zap-report.html', allowEmptyArchive: true
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'PIPELINE SUCCESS — CI Pipeline hoàn thành!'
            echo "CD PIPELINE SUCCESS — Deployed ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }
        failure {
            echo 'PIPELINE FAILED — Kiểm tra logs để debug!'
        }
        always {
            echo "Pipeline finished at: ${currentBuild.duration}ms"
            cleanWs()
        }
    }
}
